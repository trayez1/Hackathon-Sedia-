# Copy this file to .env if your backend isn't running at the default
# http://localhost:4000 (e.g. a different port, or a deployed URL).
#
# Running in the Android emulator (via Capacitor)? "localhost" from inside
# the emulator means the emulator itself, not your host machine, so it
# can't reach a backend running on your computer. Use the emulator's
# special alias to your host machine's loopback instead:
#
#   VITE_API_BASE_URL=http://10.0.2.2:4000
#
# On a physical Android device on the same Wi-Fi, use your computer's LAN
# IP instead (e.g. http://192.168.1.23:4000), and make sure CORS_ORIGIN in
# backend/.env allows it (or just set it to "*" for local testing).

VITE_API_BASE_URL=http://localhost:4000
